# BURN — Supabase configuration
# Copy this file to .env.local and fill in your project credentials.
# Without these, the app runs in local-fallback mode (feed uses mock data,
# submissions/feedback are not saved, roasts use the canned-line engine).

VITE_SUPABASE_URL=https://drvmypgnbkinvnjrpjgf.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRydm15cGduYmtpbnZuanJwamdmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY0NTM2NjIsImV4cCI6MjEwMjAyOTY2Mn0.j_ezYMUv-bmiYPXbF7fyT5MkcEuI0sOQsezADhCr6mE

# --- Dynamic roasts (optional) ---
# Full URL of the deployed `roast` Edge Function. When set, submissions are
# roasted by an LLM (see supabase/functions/roast/README for the server-side
# ROAST_LLM_* secrets). When missing/unreachable, the canned engine is used.
VITE_ROAST_ENDPOINT=

# --- Social previews (optional) ---
# Public URL of the deployed frontend. Used for og:url, canonical links and
# as the fallback when Supabase is not configured.
VITE_SITE_URL=

# --- Voice-over (optional) ---
# Full URL of the deployed `tts` Edge Function. When unset, the app derives it
# from VITE_SUPABASE_URL, and falls back to Google's public voice if that fails.
# Server-side secrets control the actual voice (see README): TTS_ELEVENLABS_API_KEY
# + TTS_VOICE_ID enable a custom/cloned voice, e.g. a licensed Wikky Thug clone.
VITE_TTS_ENDPOINT=
